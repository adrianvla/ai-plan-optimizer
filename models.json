{
  "_comment": "LLM model + plan capability database for oh-my-openagent optimizer. April 2026.",
  "skills": {
    "vibe": {
      "description": "Overall quality feel \u2014 does output feel right, polished, coherent? High vibe = great at zero-shot, nuanced, literary.",
      "mandatory": true
    },
    "hardworkingness": {
      "description": "Does the model actually do the full task without cutting corners, summarizing instead of doing, or giving up early?",
      "mandatory": true
    },
    "agentic": {
      "description": "Quality of tool use, multi-step planning, loop recovery, and self-correction in autonomous agent loops.",
      "mandatory": true
    },
    "creative": {
      "description": "Strength at open-ended generation, lateral thinking, novel solutions, design, storytelling.",
      "mandatory": false
    },
    "specialist": {
      "description": "Depth in a specific domain (code, math, science). High = near-expert precision in its niche.",
      "mandatory": false
    },
    "speed": {
      "description": "Latency + throughput. How fast does it produce usable output at scale?",
      "mandatory": false
    },
    "instruction_following": {
      "description": "How faithfully does the model follow complex, multi-constraint instructions without drifting?",
      "mandatory": false
    },
    "librarian": {
      "description": "Ability to retrieve, organize, and synthesize information from large context windows accurately.",
      "mandatory": false
    },
    "context_fidelity": {
      "description": "How well does the model stay grounded in provided context without hallucinating or contradicting it?",
      "mandatory": false
    }
  },
